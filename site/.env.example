DATABASE_URL="file:./dev.db"
# Supabase deployment: DATABASE_URL uses the transaction pooler (6543, pgbouncer=true).
# DIRECT_URL uses the session pooler (5432) for migrations. Both require the DB password.
DIRECT_URL=""
SUPABASE_URL=""
# Server-only secret: NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ibq-private"
AUTH_SECRET="replace-with-a-long-random-string"
# Google Cloud OAuth web client. Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google (replace the origin in production)
# https://ibqwebsites.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
STRIPE_SECRET_KEY="sk_test_..."
# Optional LOCAL development only. Never used in production.
ALLOW_LOCAL_TEST_PAYMENTS="false"
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
ADMIN_EMAIL="admin@ibq.local"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set true on trusted Vercel deployments (do not expose the dev server publicly).
AUTH_TRUST_HOST="true"
# Optional: sends admin email through Resend. Without it, local notifications log to the terminal.
RESEND_API_KEY="re_..."
FROM_EMAIL="IBQ <quotes@yourdomain.com>"
