DATABASE_URL="file:./dev.db"
# Supabase deployment: DATABASE_URL uses the transaction pooler (6543, pgbouncer=true).
# Keep privileged migration credentials in a separate private administration environment.
# Deployed DATABASE_URL and DIRECT_URL must use the restricted ibq_runtime role.
DIRECT_URL=""
SUPABASE_URL=""
# Server-only secret: NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ibq-private"
AUTH_SECRET="replace-with-a-long-random-string"
# Google Cloud OAuth web client. Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google (replace the origin in production)
# https://ibqwebsites.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
STRIPE_SECRET_KEY="sk_test_..."
# Off until an explicit Stripe test setup; live additionally requires owner approval.
PAYMENTS_MODE="off"
PAYMENTS_LIVE_APPROVED="false"
# Legacy compatibility variable; fake payment unlocking has been removed.
ALLOW_LOCAL_TEST_PAYMENTS="false"
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
ADMIN_EMAIL="admin@ibq.local"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set true on trusted Vercel deployments (do not expose the dev server publicly).
AUTH_TRUST_HOST="true"
# Optional generic dashboard-activity email. Customer content is never logged/emailed.
RESEND_API_KEY="re_..."
FROM_EMAIL="IBQ <quotes@yourdomain.com>"
